{
  "name": "mmmf",
  "version": "1.2.0",
  "type": "module",
  "description": "MMMF - Max Money Market Funds. Balance forecasting tool.",
  "main": "server/index.js",
  "author": "Jason Yang",
  "license": "MIT",
  "keywords": [
    "mmmf",
    "budget",
    "forecast",
    "accounting",
    "balance",
    "money-market-funds"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jasonyang-ee/MMMF.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && vite",
    "build": "cd client && vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "build:worker": "wrangler deploy --dry-run --outdir .wrangler/build",
    "build:pages": "wrangler pages functions build functions --outdir .wrangler/pages",
    "test:ui": "playwright test --config tests/playwright.config.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "hono": "^4.11.4",
    "nanoid": "^5.1.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^7.2.6",
    "wrangler": "^4.53.0"
  }
}
